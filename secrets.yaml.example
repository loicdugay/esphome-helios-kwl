# ═══════════════════════════════════════════════════════════════════
# Modele de secrets — copiez ce fichier en "secrets.yaml" et remplacez
# TOUTES les valeurs. secrets.yaml est ignore par git (.gitignore) et ne
# doit jamais etre commite.
# ═══════════════════════════════════════════════════════════════════

wifi_ssid: "VotreSSID"
wifi_password: "VotreMotDePasseWiFi"

# Cle de chiffrement de l'API Home Assistant.
# Generez la votre (32 octets en base64) :
#   openssl rand -base64 32
# ou depuis https://esphome.io/components/api.html (bouton "Generate")
api_key: "REMPLACEZ-PAR-VOTRE-CLE-BASE64-32-OCTETS="

# Mot de passe des mises a jour OTA
ota_password: "VotreMotDePasseOTA"

# Mot de passe du point d'acces WiFi de secours (8 caracteres minimum)
ap_password: "MotDePasseDeSecours"
